{
  "name": "peek",
  "version": "0.6.0",
  "description": "Desktop pop-up overlay that shows a live Frigate camera feed when an object is detected",
  "license": "MIT",
  "author": "Peek",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "test:e2e": "playwright test -c test/e2e"
  },
  "build": {
    "appId": "io.github.peek.app",
    "productName": "Peek",
    "afterPack": "scripts/afterPack.js",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "mqtt": "^5.10.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "aedes": "1.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "selfsigned": "5.5.0",
    "ws": "8.22.0"
  }
}
